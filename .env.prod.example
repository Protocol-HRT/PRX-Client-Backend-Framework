APP_NAME=prx-backend
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL of the deployment — used for links, assets, redirects.
APP_URL=https://your-domain.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ----- Database (managed by docker-compose.prod.yml 'mysql' service) -----
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=prx_backend
DB_USERNAME=prx
# Also used by compose to create the database/user:
DB_PASSWORD=change_me_db_password
# Only used by compose to bootstrap MySQL:
DB_ROOT_PASSWORD=change_me_root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Media uploaded through the admin (curator) lands on the 'public' disk.
FILESYSTEM_DISK=public
# Override only when assets are served from a CDN:
# STORAGE_URL=https://cdn.example.com

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis is shared across all prx-backend instances — namespace every key from APP_NAME.
# Tune these if multiple apps share the same Redis server.
CACHE_PREFIX=prx_
REDIS_PREFIX=prx_
HORIZON_PREFIX=prx_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=change_me_smtp_host
MAIL_PORT=587
MAIL_USERNAME=change_me_smtp_username
MAIL_PASSWORD=change_me_smtp_password
MAIL_FROM_ADDRESS="hello@your-domain.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional S3 media offload (otherwise media stays on the app-storage volume):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# First admin (used by the AdminUserSeeder on the very first migrate --seed run).
# These are secrets — never commit the real .env.prod.
ADMIN_NAME=Administrator
ADMIN_EMAIL=change_me_admin_email
ADMIN_PASSWORD=change_me_admin_password

# Livewire/Filament on the app origin:
# SANCTUM_STATEFUL_DOMAINS=your-domain.example.com