# syntax=docker/dockerfile:1

# ---- Base: FrankenPHP image with all required PHP extensions ----
FROM dunglas/frankenphp:1-php8.4-alpine AS php-base

RUN apk add --no-cache \
    bash \
    curl \
    git \
    su-exec \
    unzip \
    sqlite \
    sqlite-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    icu-dev

RUN git config --global --add safe.directory /var/www/html

RUN install-php-extensions \
    bcmath \
    ctype \
    curl \
    dom \
    exif \
    fileinfo \
    filter \
    gd \
    intl \
    mbstring \
    opcache \
    openssl \
    pcntl \
    pdo \
    pdo_mysql \
    pdo_sqlite \
    posix \
    redis \
    session \
    tokenizer \
    xml \
    zip

# Production PHP settings
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Custom Caddyfile
COPY docker/Caddyfile /etc/caddy/Caddyfile

# ---- 1. PHP dependencies + published assets ----
FROM php-base AS deps
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app
COPY . .
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader
RUN php artisan livewire:publish --assets

# ---- 2. Frontend assets ----
FROM node:20-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts || npm install --ignore-scripts
COPY . .
COPY --from=deps /app/vendor /app/vendor
RUN npm run build

# ---- 3. FrankenPHP runtime ----
FROM php-base AS runtime
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /var/www/html
COPY --from=deps /app /var/www/html
COPY --from=frontend /app/public/build /var/www/html/public/build

# Set permissions for web server and workers
RUN chown -R root:root /var/www/html && \
    chmod -R 755 /var/www/html && \
    mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache && \
    chown -R www-data:www-data storage bootstrap/cache && \
    chmod -R 775 storage bootstrap/cache

EXPOSE 80 443 443/udp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
